# Native (non-deepmd) smoke test for libsog_lmp.so.
# Proves the abstraction: a plain pair style that writes atom->q feeds the
# SOG kspace through the native charge path (no SogChargeSource, no deepmd),
# and `fix sog/response` degrades to the documented NativeChargeResponse
# no-op with a one-time warning.
#
# Run from this directory (plugin defaults to ../build/libsog_lmp.so):
#   lmp -in native_smoke.in
# Override either path:
#   lmp -var plugin /abs/libsog_lmp.so -in native_smoke.in
units metal
atom_style charge
boundary p p p
lattice fcc 4.05
region box block 0 2 0 2 0 2
create_box 1 box
create_atoms 1 box
mass 1 22.99

group pos id 1:31:2
group neg id 2:32:2
set group pos charge 1.0
set group neg charge -1.0

pair_style lj/cut/coul/long 6.5
pair_coeff * * 0.1 2.4

variable plugin index ../build/libsog_lmp.so
plugin load ${plugin}

kspace_style sog amp 78.80229949951172 316.9695129394531 1267.8780517578125 5071.51220703125 20286.048828125 81144.1953125 324576.78125 1298307.125 5193228.5 20772914.0 83091656.0 332366624.0 bandwidth 9.097501754760742 36.39000701904297 145.56002807617188 582.2401123046875 2328.96044921875 9315.841796875 37263.3671875 149053.46875 596213.875 2384855.5 9539422.0 38157688.0 m 12 b 2.0 sigma 3.0162065545167596 spline cubes2_4 remove_self_interaction yes phi_max 0.23

# Native adapter: expects a warning, then a zero charge-response.
fix sresp all sog/response

thermo 1
thermo_style custom step pe press
run 2
